{
  "name": "@local/reverse-skill-tools",
  "version": "1.0.0",
  "description": "Local DeepSeek Harness bundle that wraps every @dhicoc/dsh-reverse-skill SKILL.md as a native DSH tool: one tool per skill (snake_case name), returning the full SKILL.md body on call.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reverse-skill",
    "tools",
    "security-research"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}